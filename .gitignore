sign_body_*
*.har
*.pcap
*.pcapng

# mitmproxy 运行目录与产物
mitm/
mitm-out/
.mitmproxy/
*.mitmproxy
mitmproxy-ca*.pem
mitmproxy-ca*.cer
mitmproxy-ca*.p12
mitmproxy-dhparam.pem

# 日志
*.log
jl_capture.log

# 抓包/调试备份（可能含 token、cookie、手机号）
